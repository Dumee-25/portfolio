---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, stack } from '../site';

// Featured entries carry a `home` block in their frontmatter; the three with
// the lowest rank in each lens are shown here.
const systems = await getCollection('systems');
const inquiry = await getCollection('inquiry');
const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const byRank = <T extends { data: { home?: { rank: number } } }>(xs: T[]) =>
  xs
    .filter((x) => x.data.home)
    .sort((a, b) => a.data.home!.rank - b.data.home!.rank)
    .slice(0, 3);

const research = byRank(inquiry);
const engineering = byRank(systems);
const latestNotes = notes.slice(0, 3);

const inquiryStatus: Record<string, string> = {
  published: 'Published',
  accepted: 'Accepted',
  'under-review': 'Under review',
  ongoing: 'In progress',
  rejected: 'Rejected',
};
const systemStatus: Record<string, string> = {
  prototype: 'Prototype',
  deployed: 'Deployed',
  archived: 'Archived',
};
// Green is kept for outcomes someone else signed off on.
const isOutcome = (s: string) => ['published', 'accepted', 'deployed'].includes(s);

// Only link a repository visitors can open.
const publicRepo = (receipts: { label: string; url: string }[]) =>
  receipts.find((r) => r.label.startsWith('repository') && !r.label.includes('private'));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title={`${site.name}, engineer-researcher`}
  description="Dumindu Kumarapeli builds ML systems and tests whether they work: LLM and RAG systems, applied modelling and computer vision."
>
  <section class="wrap hero">
    <div class="hero__text">
      <p class="kicker">{site.role} · NSBM Green University, Sri Lanka</p>
      <h1 class="hero__lede">I build ML systems, and I test whether they work.</h1>
      <p class="hero__std">
        LLM and RAG systems, applied modelling and computer vision, built end to
        end from data to deployment. Most of it runs on a 6&nbsp;GB laptop GPU.
      </p>

      <ul class="record">
        <li>
          <span class="record__label">Best Overall Research</span>
          <span>NSRSIT 2026, <a href="/inquiry/privacy-eda">privacy-preserving EDA</a></span>
        </li>
        <li>
          <span class="record__label">Oral presentation, accepted</span>
          <span>ICCMM 2026, <a href="/inquiry/dengue-timescale">dengue model reduction</a></span>
        </li>
      </ul>

      <div class="actions">
        <a class="btn btn--primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn" href={site.cv} download>Download CV</a>
        <a class="plain" href={site.github} rel="me">GitHub ↗</a>
        <a class="plain" href={site.linkedin} rel="me">LinkedIn ↗</a>
      </div>
    </div>

    <figure class="hero__portrait">
      <img
        src="/dp-portrait.jpg"
        alt={`${site.name} presenting at Data Storm 7.0`}
        width="600"
        height="750"
        loading="eager"
      />
      <figcaption>Presenting at Data Storm 7.0</figcaption>
    </figure>
  </section>

  <section class="rule-top">
    <div class="wrap section">
      <h2 id="work">Selected work</h2>
      <p class="intro">Papers and systems. Some projects are both.</p>

      <div class="lenses">
        <div class="lens">
          <div class="lens__head">
            <h3>Research</h3>
            <span>{inquiry.length} entries</span>
          </div>
          {
            research.map((q) => {
              const h = q.data.home!;
              return (
                <article class="item">
                  <p class="item__meta">
                    <span class:list={['item__status', { 'is-outcome': isOutcome(q.data.status) }]}>
                      {inquiryStatus[q.data.status]}
                    </span>{' '}
                    · {h.meta}
                  </p>
                  <h4 class="item__title">
                    <a href={`/inquiry/${q.id}`}>{q.data.title}</a>
                  </h4>
                  <p class="item__line">{h.line}</p>
                  <p class="item__links">
                    <a class="go" href={`/inquiry/${q.id}`}>Read the write-up →</a>
                    {h.also && <a class="also" href={h.also.href}>{h.also.label}</a>}
                  </p>
                </article>
              );
            })
          }
          <a class="more" href="/inquiry">All research, including rejected work →</a>
        </div>

        <div class="lens">
          <div class="lens__head">
            <h3>Engineering</h3>
            <span>{systems.length} systems</span>
          </div>
          {
            engineering.map((s) => {
              const h = s.data.home!;
              const repo = publicRepo(s.data.receipts);
              return (
                <article class="item">
                  <p class="item__meta">
                    <span class:list={['item__status', { 'is-outcome': isOutcome(s.data.status) }]}>
                      {systemStatus[s.data.status]}
                    </span>{' '}
                    · {h.meta}
                  </p>
                  <h4 class="item__title">
                    <a href={`/systems/${s.id}`}>{s.data.title}</a>
                  </h4>
                  <p class="item__line">{h.line}</p>
                  <p class="item__stack">{s.data.stack.slice(0, 6).join(' · ')}</p>
                  <p class="item__limit">
                    <span>Limit:</span> {h.limit}
                  </p>
                  <p class="item__links">
                    <a class="go" href={`/systems/${s.id}`}>Case study →</a>
                    {repo && <a class="go" href={repo.url}>Repository ↗</a>}
                    {h.also && <a class="also" href={h.also.href}>{h.also.label}</a>}
                  </p>
                </article>
              );
            })
          }
          <a class="more" href="/systems">All systems →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap section">
      <div class="head-row">
        <h2 id="notes">Lab log</h2>
        <a class="more" href="/notes">All {notes.length} notes →</a>
      </div>
      <p class="intro">What I'm learning, stuck on, or got wrong.</p>
      <ul class="log">
        {
          latestNotes.map((n) => (
            <li>
              <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmtDate(n.data.date)}</time>
              <a href={`/notes#${n.id}`}>{n.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap section">
    <h2 id="stack">What I work with</h2>
    <dl class="tools">
      {
        stack.map((g) => (
          <div>
            <dt>{g.group}</dt>
            <dd>{g.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="rule-top">
    <div class="wrap section">
      <h2 id="contact">Contact</h2>
      <p class="contact__text">
        {site.affiliation}. Get in touch about research or engineering work.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn" href={site.cv} download>Download CV</a>
        <a class="plain" href={site.github} rel="me">GitHub ↗</a>
        <a class="plain" href={site.linkedin} rel="me">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Shared ---- */
  .section {
    padding-block: var(--space-8);
  }
  .section h2 {
    margin: 0;
  }
  .rule-top {
    border-top: var(--border-hair);
  }
  .band {
    background: var(--paper-2);
    border-block: var(--border-hair);
  }
  .intro {
    margin-top: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: var(--measure);
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }
  .more {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--signal);
    text-decoration: none;
  }
  .head-row .more {
    margin-top: 0;
  }
  .more:hover {
    text-decoration: underline;
  }

  /* ---- Hero ---- */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-7) var(--space-8);
    padding-block: var(--space-8) var(--space-7);
  }
  .hero__text {
    flex: 999 1 30rem;
    min-width: 0;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__lede {
    margin-top: var(--space-4);
    max-width: 17ch;
    font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.4rem);
    line-height: 1.08;
  }
  .hero__std {
    margin-top: var(--space-5);
    max-width: 54ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .record {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0;
    max-width: 40rem;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-7);
    border-block: var(--border-hair);
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }
  .record li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .record__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--signal);
  }
  .record a {
    color: var(--signal);
    text-decoration: none;
  }
  .record a:hover {
    text-decoration: underline;
  }
  .hero__portrait {
    flex: 0 1 15rem;
    margin: 0;
  }
  .hero__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border: var(--border-hair);
    border-radius: var(--radius);
  }
  .hero__portrait figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ---- Buttons ---- */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1.25rem;
    box-sizing: border-box;
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn:hover {
    background: var(--paper-2);
  }
  .btn--primary {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--paper);
    font-weight: 500;
  }
  .btn--primary:hover {
    background: color-mix(in srgb, var(--signal) 88%, black);
  }
  .plain {
    padding-block: 0.75rem;
    text-decoration: none;
  }
  .plain:hover {
    text-decoration: underline;
  }

  /* ---- Two lenses ---- */
  .lenses {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-7) var(--space-8);
    margin-top: var(--space-6);
  }
  .lens {
    flex: 1 1 26rem;
    min-width: 0;
  }
  .lens__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--ink);
  }
  .lens__head h3 {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lens__head span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-bottom: var(--border-hair);
  }
  .item p {
    margin: 0;
  }
  .item__meta,
  .item__stack {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .item__status {
    color: var(--ink);
    font-weight: 500;
  }
  .item__status.is-outcome {
    color: var(--signal);
  }
  .item__title {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .item__title a {
    text-decoration: none;
  }
  .item__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }
  .item__limit {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .item__limit span {
    color: var(--flag);
    font-weight: 600;
  }
  .item .item__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-top: var(--space-1);
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }
  .item__links a {
    text-decoration: none;
  }
  .item__links a:hover {
    text-decoration: underline;
  }
  .go {
    color: var(--signal);
  }
  .also {
    color: var(--muted);
  }

  /* ---- Lab log ---- */
  .log {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    border-top: var(--border-hair);
  }
  .log li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: var(--border-hair);
  }
  .log time {
    flex: 0 0 7.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .log a {
    flex: 1 1 20rem;
    font-size: var(--step-1);
    text-decoration: none;
  }
  .log a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  /* ---- Tools ---- */
  .tools {
    margin: var(--space-5) 0 0;
    border-top: var(--border-hair);
  }
  .tools div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--border-hair);
  }
  .tools dt {
    flex: 0 0 11rem;
    padding-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tools dd {
    flex: 1 1 18rem;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
  }

  /* ---- Contact ---- */
  .contact__text {
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
</style>
